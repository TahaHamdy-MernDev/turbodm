---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'TurboDM — IDM-Class Download Speed, Built Natively for Fedora Linux',
  description = 'High-speed native Linux download manager inspired by IDM for Fedora GNOME (GTK4 + Libadwaita). Up to 32x parallel dynamic segmentation, crash-safe SQLite resume, yt-dlp + ffmpeg video grabber, and Chrome & Firefox extensions.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/og-image.png', Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'TurboDM',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Linux, Fedora Linux (GNOME / Wayland)',
  softwareVersion: '1.0.0',
  license: 'https://opensource.org/licenses/MIT',
  url: canonicalURL.toString(),
  downloadUrl: 'https://github.com/TahaHamdy-MernDev/turbodm/releases',
  codeRepository: 'https://github.com/TahaHamdy-MernDev/turbodm',
  description,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  author: {
    '@type': 'Person',
    name: 'TahaHamdy-MernDev',
    url: 'https://github.com/TahaHamdy-MernDev',
  },
};
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0E1117" />
    <meta name="keywords" content="TurboDM, IDM for Linux, Fedora download manager, GTK4 download manager, Libadwaita, multi-part download accelerator, yt-dlp GUI, Linux Wayland download manager" />

    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="TurboDM" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-surface text-on-surface font-body antialiased selection:bg-primary-container selection:text-on-primary-container">
    <slot />
  </body>
</html>
