---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import MetricsStrip from '../components/MetricsStrip.astro';
import FeatureBento from '../components/FeatureBento.astro';
import BrowserIntegration from '../components/BrowserIntegration.astro';
import QuickInstall from '../components/QuickInstall.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Navbar />
  <main>
    <Hero />
    <MetricsStrip />
    <FeatureBento />
    <BrowserIntegration />
    <QuickInstall />
    <ComparisonTable />
    <FinalCta />
  </main>
  <Footer />

  <script>
    // 1. Mobile Navigation Drawer Toggle
    const menuBtn = document.getElementById('mobile-menu-btn');
    const menuDrawer = document.getElementById('mobile-menu-drawer');
    const setMenuOpen = (open: boolean) => {
      if (!menuBtn || !menuDrawer) return;
      menuBtn.setAttribute('aria-expanded', String(open));
      menuDrawer.classList.toggle('hidden', !open);
      if (open) {
        menuDrawer.removeAttribute('hidden');
      } else {
        menuDrawer.setAttribute('hidden', '');
      }
      menuBtn.querySelector('.menu-icon-open')?.classList.toggle('hidden', open);
      menuBtn.querySelector('.menu-icon-close')?.classList.toggle('hidden', !open);
    };
    menuBtn?.addEventListener('click', () => {
      const currentlyOpen = menuBtn.getAttribute('aria-expanded') === 'true';
      setMenuOpen(!currentlyOpen);
    });
    document.querySelectorAll('.mobile-nav-link').forEach((link) => {
      link.addEventListener('click', () => setMenuOpen(false));
    });

    // 2. Install Tabs + Dynamic Copy Target Sync
    const tabs = document.querySelectorAll<HTMLButtonElement>('.install-tab');
    const panels = document.querySelectorAll<HTMLElement>('.install-panel');
    const installCopyBtn = document.getElementById('install-copy-btn');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetId = tab.getAttribute('aria-controls');
        const copyTarget = tab.getAttribute('data-copy-for');

        tabs.forEach((t) => {
          const active = t === tab;
          t.setAttribute('aria-selected', String(active));
          t.setAttribute('tabindex', active ? '0' : '-1');
          t.classList.toggle('bg-primary', active);
          t.classList.toggle('text-on-primary', active);
          t.classList.toggle('text-on-surface-variant', !active);
        });

        panels.forEach((panel) => {
          if (panel.id === targetId) {
            panel.removeAttribute('hidden');
            panel.classList.remove('hidden');
          } else {
            panel.setAttribute('hidden', '');
            panel.classList.add('hidden');
          }
        });

        if (installCopyBtn && copyTarget) {
          installCopyBtn.setAttribute('data-copy-target', copyTarget);
        }
      });
    });

    // 3. Copy-to-Clipboard with Visual Confirmation
    document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const targetId = btn.getAttribute('data-copy-target');
        const targetEl = targetId ? document.getElementById(targetId) : null;
        if (!targetEl) return;
        const text = (targetEl.textContent || '').trim();
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          // Ignore if clipboard blocked
        }
        const defIcon = btn.querySelector('.copy-icon-default');
        const doneIcon = btn.querySelector('.copy-icon-done');
        const label = btn.querySelector('.copy-label');
        defIcon?.classList.add('hidden');
        doneIcon?.classList.remove('hidden');
        if (label) label.textContent = 'Copied';
        setTimeout(() => {
          defIcon?.classList.remove('hidden');
          doneIcon?.classList.add('hidden');
          if (label) label.textContent = 'Copy';
        }, 1600);
      });
    });

    // 4. Optional Live GitHub Star Count Hydration (Desktop + Mobile Drawer)
    const starEls = document.querySelectorAll<HTMLElement>('.gh-star-count');
    if (starEls.length > 0) {
      fetch('https://api.github.com/repos/TahaHamdy-MernDev/turbodm')
        .then((r) => (r.ok ? r.json() : null))
        .then((data) => {
          if (data && typeof data.stargazers_count === 'number' && data.stargazers_count > 0) {
            starEls.forEach((el) => {
              el.textContent = String(data.stargazers_count);
            });
          }
        })
        .catch(() => {});
    }

    // 5. Interactive 16-Segment Dynamic Segmentation Simulator (Syncs Mobile + Desktop)
    const replayBtn = document.getElementById('sim-replay-btn');
    const gridEl = document.getElementById('sim-segment-grid');
    if (replayBtn && gridEl) {
      let timer: number | undefined;
      const pctBadge = document.getElementById('sim-pct-badge');
      const speedEl = document.getElementById('sim-speed');
      const statusEl = document.getElementById('sim-status-label');
      const rowBars = document.querySelectorAll<HTMLElement>('.hero-row1-bar');
      const rowSizes = document.querySelectorAll<HTMLElement>('.hero-row1-size');
      const rowPctDesktop = document.getElementById('hero-row1-pct');
      const rowEtaDesktop = document.getElementById('hero-row1-eta');
      const rowPctEtaMobile = document.querySelector<HTMLElement>('.hero-row1-pct-eta');

      const startSim = () => {
        if (timer) window.clearInterval(timer);
        const segs = Array.from({ length: 16 }, () => Math.random() * 12);
        const speeds = Array.from({ length: 16 }, (_, i) => (i % 5 === 0 ? 1.8 : 4.2 + Math.random() * 3.5));

        timer = window.setInterval(() => {
          let doneCount = 0;
          for (let i = 0; i < 16; i++) {
            if (segs[i] >= 100) doneCount++;
          }
          const boost = 1 + doneCount * 0.14;
          let sum = 0;
          for (let i = 0; i < 16; i++) {
            if (segs[i] < 100) {
              segs[i] = Math.min(100, segs[i] + speeds[i] * boost * 0.65);
            }
            sum += segs[i];
            const cell = gridEl.children[i] as HTMLElement | undefined;
            if (!cell) continue;
            const fill = cell.querySelector<HTMLElement>('.seg-fill');
            let tip = cell.querySelector<HTMLElement>('.seg-tip');
            if (fill) {
              fill.style.width = `${segs[i].toFixed(1)}%`;
              if (segs[i] >= 100) {
                fill.classList.remove('bg-adwaita-blue');
                fill.classList.add('bg-emerald-green');
                tip?.remove();
              } else {
                fill.classList.add('bg-adwaita-blue');
                fill.classList.remove('bg-emerald-green');
                if (!tip) {
                  tip = document.createElement('div');
                  tip.className = 'seg-tip w-0.5 sm:w-1 h-full bg-cyan-tip shrink-0';
                  cell.appendChild(tip);
                }
              }
            }
          }

          const avg = sum / 16;
          const gb = ((avg / 100) * 2.41).toFixed(2);
          const rate = avg >= 100 ? 0 : 44 + Math.random() * 12;
          const eta = avg >= 100 ? 'Done' : `${Math.max(1, Math.round(((100 - avg) / 100) * 48))}s`;

          if (pctBadge) pctBadge.textContent = `${avg.toFixed(1)}%`;
          if (speedEl) speedEl.textContent = avg >= 100 ? 'Completed' : `${rate.toFixed(1)} MB/s`;
          if (statusEl) {
            statusEl.textContent =
              avg >= 100 ? 'All 16 Segments Merged' : doneCount > 0 ? `Dynamic Split (${doneCount} stolen)` : '16 Parallel Streams';
          }
          rowBars.forEach((b) => { b.style.width = `${avg.toFixed(1)}%`; });
          rowSizes.forEach((s) => { s.textContent = `${gb} / 2.41 GB`; });
          if (rowPctDesktop) rowPctDesktop.textContent = avg >= 100 ? '100% • Done' : `${avg.toFixed(1)}% • 16x`;
          if (rowEtaDesktop) rowEtaDesktop.textContent = eta;
          if (rowPctEtaMobile) rowPctEtaMobile.textContent = avg >= 100 ? '100% • Done' : `${avg.toFixed(1)}% • 16x • ${eta}`;

          if (avg >= 100 && timer) {
            window.clearInterval(timer);
            timer = undefined;
          }
        }, 160);
      };

      replayBtn.addEventListener('click', startSim);
    }
  </script>
</Layout>
